<Window x:Class="Ch02.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="레이아웃" Height="350" Width="500">
    <TabControl>
        <TabItem Header="Grid">
            <Grid ShowGridLines="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Header" Grid.ColumnSpan="2" Background="LightBlue" Padding="5"/>
                <TextBlock Text="Sidebar" Grid.Row="1" Background="LightYellow" Padding="5"/>
                <TextBlock Text="Content" Grid.Row="1" Grid.Column="1" Background="LightGreen" Padding="5"/>
                <TextBlock Text="Footer" Grid.Row="2" Grid.ColumnSpan="2" Background="LightCoral" Padding="5"/>
            </Grid>
        </TabItem>
        <TabItem Header="StackPanel">
            <StackPanel Margin="10">
                <Button Content="Button 1" Margin="0,0,0,5"/>
                <Button Content="Button 2" Margin="0,0,0,5"/>
                <Button Content="Button 3"/>
            </StackPanel>
        </TabItem>
        <TabItem Header="WrapPanel">
            <WrapPanel Margin="10">
                <Button Content="Item 1" Width="80" Height="30" Margin="3"/>
                <Button Content="Item 2" Width="80" Height="30" Margin="3"/>
                <Button Content="Item 3" Width="80" Height="30" Margin="3"/>
                <Button Content="Item 4" Width="80" Height="30" Margin="3"/>
                <Button Content="Item 5" Width="80" Height="30" Margin="3"/>
                <Button Content="Item 6" Width="80" Height="30" Margin="3"/>
            </WrapPanel>
        </TabItem>
        <TabItem Header="DockPanel">
            <DockPanel Margin="10">
                <TextBlock Text="Top" DockPanel.Dock="Top" Background="LightBlue" Padding="5" Height="30"/>
                <TextBlock Text="Bottom" DockPanel.Dock="Bottom" Background="LightCoral" Padding="5" Height="30"/>
                <TextBlock Text="Left" DockPanel.Dock="Left" Background="LightYellow" Padding="5" Width="80"/>
                <TextBlock Text="Right" DockPanel.Dock="Right" Background="LightGray" Padding="5" Width="80"/>
                <TextBlock Text="Center" Background="LightGreen" Padding="5"/>
            </DockPanel>
        </TabItem>
    </TabControl>
</Window>

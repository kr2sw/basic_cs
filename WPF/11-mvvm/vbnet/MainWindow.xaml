<Window x:Class="Ch11.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MVVM 패턴" Height="350" Width="500">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="MVVM 패턴 예제" FontSize="22"
                   FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="이름:" VerticalAlignment="Center" Margin="5"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 Margin="5" Padding="5"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="설명:" VerticalAlignment="Center" Margin="5"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 Margin="5" Padding="5" AcceptsReturn="True" MinHeight="60"/>

        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding Output, Mode=OneWay}"
                   FontWeight="Bold" Foreground="Blue" Margin="5"
                   HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="5">
            <Button Content="표시" Command="{Binding ShowCommand}" Margin="5" Padding="15,8"/>
            <Button Content="초기화" Command="{Binding ClearCommand}" Margin="5" Padding="15,8"/>
        </StackPanel>

        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Margin="5" Foreground="Gray" FontSize="11"
                   TextWrapping="Wrap" VerticalAlignment="Bottom"
                   Text="ViewModel이 DataContext로 설정됩니다. INotifyPropertyChanged로 UI가 업데이트됩니다."/>
    </Grid>
</Window>

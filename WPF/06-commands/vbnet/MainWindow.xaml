<Window x:Class="Ch06.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF 커맨드" Height="300" Width="450">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="WPF 커맨드 예제" FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="5"/>

        <TextBox x:Name="inputBox" Grid.Row="1" Margin="5" Padding="5"
                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="대문자로" Command="{Binding UpperCommand}" Margin="5" Padding="10,5"/>
            <Button Content="소문자로" Command="{Binding LowerCommand}" Margin="5" Padding="10,5"/>
            <Button Content="초기화" Command="{Binding ClearCommand}" Margin="5" Padding="10,5"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{Binding Text}" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="5"/>

        <CheckBox Grid.Row="4" Content="커맨드 활성화" IsChecked="{Binding CanModify, Mode=TwoWay}"
                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="5"/>
    </Grid>
</Window>

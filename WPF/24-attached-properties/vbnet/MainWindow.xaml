<Window x:Class="Ch24.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ch24"
        Title="24 - 첨부 속성 (Attached Property)" Height="470" Width="560">
    <Window.Resources>
        <!-- TextBox 전용 스타일: 내용이 비어 있으면 워터마크 템플릿으로 교체 -->
        <Style TargetType="TextBox">
            <Setter Property="local:Watermark.Text" Value="기본 입력란"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="White" BorderBrush="Gray" BorderThickness="1"
                                        CornerRadius="3">
                                    <Grid>
                                        <!-- 첨부 속성 값을 템플릿 안에서 읽습니다 -->
                                        <TextBlock Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(local:Watermark.Text)}"
                                                   Foreground="#FFAAAAAA" Margin="5,4" IsHitTestVisible="False"/>
                                        <ScrollViewer x:Name="PART_ContentHost" Margin="3"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="첨부 속성: 요소마다 다른 워터마크" FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,16"/>

        <!-- 요소마다 다른 첨부 속성 값 (컨테이너별 값) -->
        <TextBox Grid.Row="1" x:Name="nameBox" local:Watermark.Text="이름을 입력하세요"/>
        <TextBox Grid.Row="2" x:Name="emailBox" local:Watermark.Text="example@mail.com"/>
        <TextBox Grid.Row="3" x:Name="plainBox" Text="내용이 있으면 워터마크가 표시되지 않습니다"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,4,0,0">
            <Button Content="첨부 속성 값 읽기" Click="ReadWatermark_Click" Padding="12,6"/>
        </StackPanel>

        <Border Grid.Row="5" Background="#FFF7F7F7" BorderBrush="LightGray" BorderThickness="1"
                Padding="10" Margin="0,12,0,0">
            <TextBlock x:Name="resultText" TextWrapping="Wrap" FontFamily="Consolas"/>
        </Border>

        <TextBlock Grid.Row="6" Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                   VerticalAlignment="Bottom"
                   Text="첨부 속성은 각 요소(DependencyObject)의 속성 저장소에 값이 보관됩니다. 같은 형식의 요소라도 요소별로 독립된 값을 가질 수 있고, 템플릿/스타일에서도 읽을 수 있습니다."/>
    </Grid>
</Window>

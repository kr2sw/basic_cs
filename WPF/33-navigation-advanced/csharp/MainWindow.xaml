<Window x:Class="Ch33.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="33 - 고급 내비게이션" Height="460" Width="640">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Frame + Page 내비게이션 (MVVM)"
                   FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12"/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="홈" Command="{Binding GoHomeCommand}" Padding="14,7"/>
            <Button Content="설정" Command="{Binding GoSettingsCommand}" Padding="14,7" Margin="8,0,0,0"/>
            <Button Content="뒤로" Click="Back_Click" Padding="14,7" Margin="8,0,0,0"/>
            <Button Content="앞으로" Click="Forward_Click" Padding="14,7" Margin="8,0,0,0"/>
        </StackPanel>

        <Border BorderBrush="#CCCCCC" BorderThickness="1">
            <Frame x:Name="frame"/>
        </Border>
    </DockPanel>
</Window>

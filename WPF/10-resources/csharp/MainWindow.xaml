<Window x:Class="Ch10.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF 리소스" Height="350" Width="500"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource AppForegroundBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="WarningBrush" Color="OrangeRed"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="ForestGreen"/>
        <Style x:Key="ResourceButton" TargetType="Button">
            <Setter Property="Margin" Value="{StaticResource DefaultMargin}"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Background" Value="DodgerBlue"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="15">
        <TextBlock Text="WPF 리소스 예제" FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center">
            <TextBlock.Foreground>
                <DynamicResource ResourceKey="AppForegroundBrush"/>
            </TextBlock.Foreground>
        </TextBlock>

        <TextBlock Text="애플리케이션 리소스 (App.xaml)" FontSize="14" Margin="5"/>
        <Separator Margin="5"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="StaticResource" Style="{StaticResource ResourceButton}"/>
            <Button Content="DynamicResource" Style="{DynamicResource ResourceButton}"
                    Background="Crimson"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <Button Content="경고 (로컬 리소스)" Style="{StaticResource ResourceButton}"
                    Background="{StaticResource WarningBrush}"/>
            <Button Content="성공 (로컬 리소스)" Style="{StaticResource ResourceButton}"
                    Background="{StaticResource SuccessBrush}"/>
        </StackPanel>

        <TextBlock Margin="5" TextWrapping="Wrap" Foreground="Gray" FontSize="12">
            StaticResource는 로드 시 한 번 확인되고, DynamicResource는
            런타임에 변경될 수 있습니다. App.xaml의 리소스는 전역적으로 사용 가능합니다.
        </TextBlock>
    </StackPanel>
</Window>

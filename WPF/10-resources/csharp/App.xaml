<Application x:Class="Ch10.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="AliceBlue"/>
        <SolidColorBrush x:Key="AppForegroundBrush" Color="DarkSlateBlue"/>
        <CornerRadius x:Key="DefaultCornerRadius">6</CornerRadius>
        <Thickness x:Key="DefaultMargin">5</Thickness>
    </Application.Resources>
</Application>

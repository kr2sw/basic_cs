<Window x:Class="Ch31.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="31 - 동적 리소스와 테마" Height="420" Width="560">
    <Window.Background>
        <DynamicResource ResourceKey="WindowBackgroundBrush"/>
    </Window.Background>
    <Window.Foreground>
        <DynamicResource ResourceKey="WindowForegroundBrush"/>
    </Window.Foreground>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="DynamicResource 기반 테마 전환"
                   FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="라이트 테마" Click="Light_Click" Width="120"/>
            <Button Content="다크 테마" Click="Dark_Click" Width="120" Margin="12,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="2" Margin="0,20,0,0" Padding="16" CornerRadius="6"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="미리보기" FontWeight="Bold" FontSize="16"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                <TextBox Text="테마에 따라 색이 바뀌는 텍스트 상자" Margin="0,0,0,10"/>
                <TextBlock Text="이 텍스트는 WindowForegroundBrush를 사용합니다."
                           Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                   VerticalAlignment="Bottom"
                   Text="StaticResource는 로드 시점에 한 번만 찾지만, DynamicResource는 값이 바뀔 때마다 다시 평가합니다. 테마 전환처럼 실행 중에 바뀌는 값은 반드시 DynamicResource를 사용해야 합니다."/>
    </Grid>
</Window>

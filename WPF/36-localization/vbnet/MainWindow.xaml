<Window x:Class="Ch36.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WindowTitle}" Height="380" Width="540">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="{DynamicResource LanguageGroup}" VerticalAlignment="Center"
                       FontWeight="Bold"/>
            <Button Content="한국어" Command="{Binding SetKoCommand}" Margin="12,0,0,0" Padding="16,7"/>
            <Button Content="English" Command="{Binding SetEnCommand}" Margin="8,0,0,0" Padding="16,7"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{DynamicResource EnterName}" Margin="0,20,0,4"
                   FontWeight="Bold"/>
        <TextBox Grid.Row="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 Padding="4"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="{DynamicResource GreetButton}" Command="{Binding GreetCommand}"
                    Padding="16,7"/>
            <TextBlock Text="{Binding Greeting}" VerticalAlignment="Center" Margin="16,0,0,0"
                       FontWeight="Bold" Foreground="SteelBlue"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,20,0,0">
            <TextBlock Text="{DynamicResource CultureSampleLabel}" FontWeight="Bold"/>
            <TextBlock Text="{Binding CultureSample}" Margin="0,4,0,0" FontWeight="Bold"
                       Foreground="DarkOrange"/>
        </StackPanel>

        <TextBlock Grid.Row="5" Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                   Text="{DynamicResource Hint}" VerticalAlignment="Bottom"/>
    </Grid>
</Window>

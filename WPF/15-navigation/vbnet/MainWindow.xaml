<Window x:Class="Ch15.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF 내비게이션" Height="400" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0">
            <Button Content="홈" Click="Home_Click" Margin="3"/>
            <Button Content="설정" Click="Settings_Click" Margin="3"/>
            <Separator/>
            <Button Content="← 뒤로" Click="Back_Click" Margin="3"/>
            <Button Content="앞으로 →" Click="Forward_Click" Margin="3"/>
        </ToolBar>

        <Frame x:Name="mainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="statusText" Text="준비"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

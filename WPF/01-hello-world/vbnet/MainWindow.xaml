<Window x:Class="Ch01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hello WPF" Height="200" Width="400">
    <StackPanel Margin="20">
        <TextBlock FontSize="18" FontWeight="Bold" Text="WPF에 오신 것을 환영합니다!"/>
        <TextBox x:Name="nameBox" Margin="0,10" Text="World"/>
        <Button x:Name="btnGreet" Click="BtnGreet_Click" Content="인사하기" Padding="10,5"/>
    </StackPanel>
</Window>

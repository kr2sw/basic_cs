<Window x:Class="Ch37.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ch37"
        Title="37 - 커스텀 패널" Height="640" Width="640">
    <ScrollViewer>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Panel 상속 + MeasureOverride/ArrangeOverride"
                       FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,14"/>

            <TextBlock Grid.Row="1" Text="1) WrapFlowPanel: 가로가 부족하면 줄 바꿈" FontWeight="Bold"
                       Margin="0,0,0,6"/>
            <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" Padding="8" Margin="0,0,0,24">
                <local:WrapFlowPanel x:Name="wrapPanel">
                    <Button Content="에스프레소" Padding="12,6" Margin="4"/>
                    <Button Content="카푸치노" Padding="12,6" Margin="4"/>
                    <Button Content="카페라떼" Padding="12,6" Margin="4"/>
                    <Button Content="아메리카노" Padding="12,6" Margin="4"/>
                    <Button Content="콜드브루" Padding="12,6" Margin="4"/>
                    <Button Content="레몬티" Padding="12,6" Margin="4"/>
                    <Button Content="그린티 라떼" Padding="12,6" Margin="4"/>
                    <Button Content="민트초코" Padding="12,6" Margin="4"/>
                </local:WrapFlowPanel>
            </Border>

            <TextBlock Grid.Row="3" Text="2) RadialPanel: 원형 배치 + 반지름 슬라이더" FontWeight="Bold"
                       Margin="0,0,0,6"/>
            <StackPanel Grid.Row="4">
                <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="8">
                    <local:RadialPanel x:Name="radial" Radius="110" Width="320" Height="320"
                                       HorizontalAlignment="Center" Background="#FAFAFA">
                        <Ellipse Width="44" Height="44" Fill="SteelBlue"/>
                        <Ellipse Width="44" Height="44" Fill="Tomato"/>
                        <Ellipse Width="44" Height="44" Fill="MediumSeaGreen"/>
                        <Ellipse Width="44" Height="44" Fill="DarkOrange"/>
                        <Ellipse Width="44" Height="44" Fill="MediumPurple"/>
                        <Ellipse Width="44" Height="44" Fill="DodgerBlue"/>
                        <Ellipse Width="44" Height="44" Fill="HotPink"/>
                        <Ellipse Width="44" Height="44" Fill="Sienna"/>
                    </local:RadialPanel>
                </Border>
                <TextBlock Text="반지름" Margin="0,12,0,4"/>
                <Slider Minimum="40" Maximum="180"
                        Value="{Binding ElementName=radial, Path=Radius}"/>
            </StackPanel>

            <TextBlock Grid.Row="5" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0"
                       Text="커스텀 패널은 Panel을 상속하고 두 메서드만 구현합니다. MeasureOverride는 자식들의 DesiredSize를 모아 크기를 계산하고, ArrangeOverride는 계산된 위치에 자식을 배치합니다. 슬라이더로 Radius를 바꾸면 AffectsMeasure/AffectsArrange 플래그 덕분에 레이아웃이 자동으로 다시 실행됩니다."/>
        </Grid>
    </ScrollViewer>
</Window>

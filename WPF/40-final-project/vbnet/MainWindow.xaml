<Window x:Class="Ch40.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="40 - 종합 프로젝트: 메모 앱 (MVVM + DI + 테마)" Height="560" Width="820">
    <Window.Background>
        <DynamicResource ResourceKey="WindowBackgroundBrush"/>
    </Window.Background>
    <Window.Foreground>
        <DynamicResource ResourceKey="WindowForegroundBrush"/>
    </Window.Foreground>

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Margin="0,0,0,10" Padding="8"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Button Content="추가" Command="{Binding AddCommand}"/>
                <Button Content="삭제" Command="{Binding DeleteCommand}" Margin="8,0,0,0"/>
                <Button Content="저장" Command="{Binding SaveCommand}" Margin="8,0,0,0"/>
                <TextBlock Text="검색:" VerticalAlignment="Center" Margin="20,0,6,0"/>
                <TextBox Width="180" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Margin="20,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="다크 테마로 전환"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDark}" Value="True">
                                    <Setter Property="Content" Value="라이트 테마로 전환"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Command>
                        <Binding Path="ToggleThemeCommand"/>
                    </Button.Command>
                </Button>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1">
                <ListBox ItemsSource="{Binding Notes}" SelectedItem="{Binding Selected}"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:MM-dd HH:mm}}"
                                           FontSize="10"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Grid.Column="2">
                <TextBox Text="{Binding Selected.Title, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBox Text="{Binding Selected.Body, UpdateSourceTrigger=PropertyChanged}"
                         Height="360" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </Grid>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="2,8,0,0"
                   FontSize="11"
                   Foreground="{DynamicResource MutedBrush}"/>
    </DockPanel>
</Window>

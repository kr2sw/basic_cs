<Window x:Class="Ch39.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ch39"
        Title="39 - WPF 테스팅" Height="480" Width="640">
    <Window.Resources>
        <local:BoolToResultConverter x:Key="BoolToResult"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="MVVM 단위 테스트 (미니 러너)"
                   FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,14"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="테스트 실행" Command="{Binding RunTestsCommand}" Padding="16,8"/>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="16,0,0,0"
                       FontWeight="Bold" Foreground="SteelBlue"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="LoginViewModel 테스트" FontWeight="Bold" Margin="0,0,0,6"/>

        <Border Grid.Row="3" BorderBrush="#CCCCCC" BorderThickness="1">
            <ListBox ItemsSource="{Binding Results}" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <TextBlock Text="{Binding Passed, Converter={StaticResource BoolToResult}}"
                                       FontWeight="Bold" MinWidth="40">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Passed}" Value="True">
                                                <Setter Property="Foreground" Value="Green"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Passed}" Value="False">
                                                <Setter Property="Foreground" Value="Red"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Name}" Margin="10,0,0,0"/>
                            <TextBlock Text="{Binding Message}" Foreground="Gray" FontSize="11"
                                       Margin="12,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Window>

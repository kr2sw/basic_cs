<Window x:Class="Ch14.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="대화상자 예제" Height="350" Width="500">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="대화상자 예제" FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="5"/>

        <WrapPanel Grid.Row="1" Margin="10">
            <Button Content="MessageBox" Click="MessageBox_Click" Margin="5" Padding="15,8" Width="140"/>
            <Button Content="OpenFileDialog" Click="OpenFile_Click" Margin="5" Padding="15,8" Width="140"/>
            <Button Content="SaveFileDialog" Click="SaveFile_Click" Margin="5" Padding="15,8" Width="140"/>
            <Button Content="사용자 정의 대화상자" Click="CustomDialog_Click" Margin="5" Padding="15,8" Width="140"/>
        </WrapPanel>

        <TextBlock Grid.Row="2" Text="결과:" FontSize="14" FontWeight="Bold" Margin="5,0"/>
        <TextBox x:Name="resultBox" Grid.Row="3" Margin="5" Padding="5"
                 IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"/>
    </Grid>
</Window>

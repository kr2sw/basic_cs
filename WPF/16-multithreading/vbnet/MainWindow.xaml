<Window x:Class="Ch16.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="멀티스레딩" Height="350" Width="500">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="async/await 멀티스레딩 예제" FontSize="22"
                   FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="startBtn" Content="작업 시작" Click="StartWork_Click"
                    Margin="5" Padding="15,8" Width="120"/>
            <Button Content="취소" Click="Cancel_Click" Margin="5" Padding="15,8" Width="120"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="10">
            <TextBlock Text="진행률:" Margin="5"/>
            <ProgressBar x:Name="progressBar" Minimum="0" Maximum="100" Height="25" Margin="5"/>
            <TextBlock x:Name="statusText" Text="대기 중..." HorizontalAlignment="Center" Margin="5"/>
        </StackPanel>

        <TextBox x:Name="logBox" Grid.Row="3" Margin="5" Padding="5"
                 IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"/>
    </Grid>
</Window>

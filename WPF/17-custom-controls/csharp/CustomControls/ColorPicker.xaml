<UserControl x:Class="Ch17.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="colorPickerRoot">
    <Border BorderBrush="Silver" BorderThickness="1" CornerRadius="5" Padding="10"
            Background="White">
        <StackPanel>
            <TextBlock Text="색상 선택" FontWeight="Bold" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="R:" Width="20" VerticalAlignment="Center"/>
                <Slider x:Name="redSlider" Minimum="0" Maximum="255" Width="120" Margin="5,0"/>
                <TextBlock x:Name="redValue" Text="0" Width="30" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="G:" Width="20" VerticalAlignment="Center"/>
                <Slider x:Name="greenSlider" Minimum="0" Maximum="255" Width="120" Margin="5,0"/>
                <TextBlock x:Name="greenValue" Text="0" Width="30" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="B:" Width="20" VerticalAlignment="Center"/>
                <Slider x:Name="blueSlider" Minimum="0" Maximum="255" Width="120" Margin="5,0"/>
                <TextBlock x:Name="blueValue" Text="0" Width="30" VerticalAlignment="Center"/>
            </StackPanel>
            <Border x:Name="preview" Height="30" CornerRadius="3" Margin="0,10,0,0"
                    BorderBrush="Silver" BorderThickness="1"/>
        </StackPanel>
    </Border>
</UserControl>

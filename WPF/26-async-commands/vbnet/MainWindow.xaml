<Window x:Class="Ch26.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="26 - 비동기 커맨드 (AsyncRelayCommand)" Height="380" Width="540">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="AsyncRelayCommand와 취소" FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Text="{Binding Status}" FontSize="14" FontWeight="Bold"
                   Foreground="SteelBlue" HorizontalAlignment="Center" Margin="0,0,0,8"/>

        <ProgressBar Grid.Row="2" Height="22" Minimum="0" Maximum="100"
                     Value="{Binding Progress}" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="작업 시작" Command="{Binding RunCommand}" Padding="18,8"/>
            <Button Content="취소" Command="{Binding CancelCommand}" Padding="18,8" Margin="10,0,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                   VerticalAlignment="Bottom"
                   Text="실행 중에는 RunCommand가 비활성화되어 재진입을 막고, 취소 버튼은 활성화됩니다. CancellationToken으로 협조적 취소를 구현했으며 UI 업데이트는 SynchronizationContext 덕분에 await 이후에도 안전합니다."/>
    </Grid>
</Window>

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('partials/header') %>
  <main>
    <p><%= message %></p>

    <h2>사용자 목록</h2>
    <% if (users.length > 0) { %>
      <% users.forEach(user => { %>
        <div class="card">
          <h3><a href="/users/<%= user.name %>"><%= user.name %></a></h3>
          <p>나이: <%= user.age %> | 이메일: <%= user.email %></p>
        </div>
      <% }) %>
    <% } else { %>
      <p>사용자가 없습니다.</p>
    <% } %>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
